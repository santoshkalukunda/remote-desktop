#include <winver.h>
#include "core/version.h"

// 24 = RT_MANIFEST, 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID
1 24 "app.manifest"
1 ICON "app.ico"
// IDR_PRIVACY: shown on the first-run screen
2 RCDATA "..\\PRIVACY.txt"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    RD_VERSION_MAJOR, RD_VERSION_MINOR, RD_VERSION_PATCH, 0
PRODUCTVERSION RD_VERSION_MAJOR, RD_VERSION_MINOR, RD_VERSION_PATCH, 0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "RemoteDesk"
            VALUE "FileDescription", "RemoteDesk remote desktop"
            VALUE "FileVersion", RD_VERSION_STR
            VALUE "InternalName", "RemoteDesk"
            VALUE "OriginalFilename", "RemoteDesk.exe"
            VALUE "ProductName", "RemoteDesk"
            VALUE "ProductVersion", RD_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
